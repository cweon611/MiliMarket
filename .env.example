# Server only. Copy to .env and fill in the key when available.
MILIMARKET_CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
# 워크스페이스에 묶이지 않은 키(sk-ant-usr-…)를 쓸 때만 입력. Console 워크스페이스 ID.
MILIMARKET_CLAUDE_WORKSPACE_ID=
PORT=5184

# 공공데이터포털 일반 인증키. 두 서비스 각각 활용신청/승인이 필요합니다.
# Encoding / Decoding 인증키 모두 입력 가능. VITE_ 접두사를 사용하지 마세요.
DATA_GO_KR_SERVICE_KEY=
# 서비스별로 다른 키를 사용할 때만 입력 (공통 키보다 우선).
G2B_SERVICE_KEY=
MFDS_SERVICE_KEY=
